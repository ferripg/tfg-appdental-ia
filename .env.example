POSTGRES_USER=appdental
POSTGRES_PASSWORD=
POSTGRES_DB=appdental

MINIO_ROOT_USER=adminauth
# Mínim 8 caràcters (ho exigeix MinIO)
MINIO_ROOT_PASSWORD=
# Si uses docker-compose.override.yml (2 repos alhora), el port S3 de l'host canvia:
# MINIO_PORT=9010

# Genera'l amb:  openssl rand -base64 32   (o: npx @better-auth/cli@latest secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Primer administrador (el crea `npx prisma db seed`). Contrasenya de 8+ caràcters.
SEED_ADMIN_EMAIL=admin@clinica.test
SEED_ADMIN_PASSWORD=

# Substitueix <PASSWORD_BD> per la contrasenya del teu POSTGRES_PASSWORD
# (amb docker-compose.override.yml el port és 5433)
DATABASE_URL="postgresql://appdental:<PASSWORD_BD>@localhost:5432/appdental?schema=public"

# Importació de factures amb IA (IA-23): clau de l'API d'Anthropic.
# Només s'usa al servidor (Server Actions); mai s'exposa al navegador.
ANTHROPIC_API_KEY=
