
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// AUTH (Better Auth + Prisma Adapter)
// =============================================================================

enum Role {
  ADMIN // Tot, incloent gestió d'usuaris
  MANAGER // "Espavilat" — CRUD complet del domini, exports, amortitzacions
  OPERARI // "Normal" — només crear despeses i veure llistats
}

model User {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  role          Role    @default(OPERARI)

  // Camps custom d'autenticació (no part de Better Auth, gestionats per la nostra lògica)
  actiu               Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?

  accounts Account[]
  sessions Session[]
  despeses Despesa[]

  // Inverses per a TancamentExercici
  tancaments  TancamentExercici[]
  reobriments TancamentExercici[] @relation("ReobertPer")

  // Inversa per a AuditLog (auditoria de tot el CRUD)
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

// El password de l'usuari viu aquí (camp `password`), no a User.
// providerId = mètode d'autenticació ("credential" per email/password, "google" per OAuth, etc.)
// Cada usuari pot tenir múltiples Account (un per cada mètode amb què s'ha registrat).
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// =============================================================================
// DOMINI: Proveïdors i Tipus de Despesa (taules mestre)
// =============================================================================

model Proveidor {
  id      String  @id @default(cuid())
  nif     String  @unique
  nom     String
  codiBis String?
  actiu   Boolean @default(true)

  // Camps de contacte i facturació (UC-22+, bloc 02)
  adreca          String?
  codiPostal      String?
  poblacio        String?
  email           String?
  telefon         String?
  personaContacte String?
  iban            String?
  notes           String? @db.Text

  despeses  Despesa[]
  inventari Inventari[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TipusDespesa {
  id             String  @id @default(cuid())
  codi           String  @unique
  descripcio     String
  deduible       Boolean @default(true)
  grup           Int?
  concepte       String?
  esAmortitzable Boolean @default(false)
  actiu          Boolean @default(true)

  despeses Despesa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// DOMINI: Despeses
// =============================================================================

model Despesa {
  id           String    @id @default(cuid())
  dataFactura  DateTime
  dataPagament DateTime?
  import       Decimal   @db.Decimal(12, 2)
  numFactura   String?
  descripcio   String?
  fitxerKey    String?

  tipusDespesaId String
  tipusDespesa   TipusDespesa @relation(fields: [tipusDespesaId], references: [id])

  proveidorId String?
  proveidor   Proveidor? @relation(fields: [proveidorId], references: [id])

  userId       String
  registratPer User   @relation(fields: [userId], references: [id])

  inventari Inventari?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// DOMINI: Inventari i Amortitzacions
// =============================================================================

enum EstatInventari {
  ACTIU
  BAIXA
  ELIMINAT
}

model Inventari {
  id                String         @id @default(cuid())
  dataAdquisicio    DateTime
  descripcio        String
  importAdquisicio  Decimal        @db.Decimal(12, 2)
  importAmortitzat  Decimal        @db.Decimal(12, 2) @default(0)
  percAmortitzacio  Decimal        @db.Decimal(5, 2)
  importUltimaAmort Decimal?       @db.Decimal(12, 2)
  numFactura        String?
  estat             EstatInventari @default(ACTIU)
  anyBaixa          Int?

  proveidorId String?
  proveidor   Proveidor? @relation(fields: [proveidorId], references: [id])

  despesaId String?  @unique
  despesa   Despesa? @relation(fields: [despesaId], references: [id])

  amortitzacions Amortitzacio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Amortitzacio {
  inventariId String
  inventari   Inventari @relation(fields: [inventariId], references: [id], onDelete: Cascade)
  exercici    Int
  import      Decimal   @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@id([inventariId, exercici])
}

// =============================================================================
// TANCAMENT FISCAL
// =============================================================================

model TancamentExercici {
  exercici      Int      @id
  dataTancament DateTime @default(now())
  tancatPerId   String
  tancatPer     User     @relation(fields: [tancatPerId], references: [id])

  dataReobertura DateTime?
  reobertPerId   String?
  reobertPer     User?     @relation("ReobertPer", fields: [reobertPerId], references: [id])

  notes String? @db.Text
}

// =============================================================================
// AUDITORIA — Log de totes les operacions CRUD i esdeveniments de seguretat
// =============================================================================

enum AccioAudit {
  CREATE
  UPDATE
  DELETE
  LOGIN_OK
  LOGIN_FAIL
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  USER_BLOCKED
  USER_UNBLOCKED
  ROLE_CHANGED
  EXERCICI_TANCAT
  EXERCICI_REOBERT
  AMORTITZACIONS_GENERATED
  AMORTITZACIONS_RETROCEDIDES
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // null si l'acció és del sistema o si és un LOGIN_FAIL amb email desconegut
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  accio     AccioAudit
  entitat   String? // "Despesa", "Proveidor", "User", etc. (null per esdeveniments d'auth)
  entitatId String? // id del registre afectat
  canvis    Json? // diff vell→nou per a UPDATE
  ip        String? // per a esdeveniments d'auth
  metadata  Json? // info addicional (motiu, context, etc.)

  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([entitat, entitatId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
